{
  "$id": "https://schemas.your-enterprise.com/SmartCity/Device/schema.json",
  "type": "object",
  "properties": {
    "name": { "type": "string", "title": "Name" },
    "category": {
      "type": "array",
      "items": { "type": "string" },
      "title": "Category"
    },
    "controlledProperty": {
      "type": "array",
      "items": { "type": "string" },
      "title": "Controlled Property"
    },
    "location": {
      "type": "object",
      "title": "Location (GeoJSON Point)",
      "properties": {
        "type": { "type": "string", "enum": ["Point"] },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        }
      }
    },
    "installedDuring": { "type": "string", "title": "Installed During Activity" }
  },
  "required": ["name"]
}