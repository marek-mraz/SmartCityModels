{
  "$id": "https://schemas.your-enterprise.com/SmartCity/Vehicle/schema.json",
  "type": "object",
  "properties": {
    "name": { "type": "string", "title": "Name" },
    "vehiclePlateIdentifier": { "type": "string", "title": "License Plate" },
    "vehicleType": { "type": "string", "title": "Vehicle Type" },
    "category": {
      "type": "array",
      "items": { "type": "string" },
      "title": "Category"
    },
    "speed": { "type": "number", "title": "Speed" },
    "cargoWeight": { "type": "number", "title": "Cargo Weight" },
    "serviceStatus": { "type": "string", "title": "Service Status" },
    "refVehicleModel": { "type": "string", "title": "Vehicle Model Reference" },
    "location": {
      "type": "object",
      "title": "Location (GeoJSON Point)",
      "properties": {
        "type": { "type": "string", "enum": ["Point"] },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        }
      }
    }
  },
  "required": ["name"]
}