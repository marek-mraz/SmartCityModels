{
  "$id": "https://schemas.your-enterprise.com/SmartCity/Project/schema.json",
  "type": "object",
  "properties": {
    "name": { "type": "string", "title": "Name" },
    "description": { "type": "string", "title": "Description" },
    "projectStatus": {
      "type": "string",
      "title": "Project Status",
      "enum":["planned", "ongoing", "completed"]
    },
    "budget": { "type": "number", "title": "Budget" },
    "hasActivity": { "type": "string", "title": "Activities" },
    "location": {
      "type": "object",
      "title": "Location (GeoJSON Polygon)",
      "properties": {
        "type": { "type": "string", "enum": ["Polygon"] },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "required": ["name"]
}